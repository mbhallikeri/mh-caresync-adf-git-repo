{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read Audit_log for a run_id",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare email Body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body_header",
					"value": "Ingestion and Transformation process for caresync has been completed and below is the status:"
				}
			},
			{
				"name": "Prepare email Body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body_footer",
					"value": "For any support, please reach out to adbtest@gmail.com"
				}
			},
			{
				"name": "Get the failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT count(*) as count FROM ctrl.audit_log \n WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare email subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get the failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Get the failed count').output.firstRow.count,0),'FAILED','SUCCESS' )} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare email Body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare email Body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read Audit_log for a run_id",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_app_body",
					"value": {
						"value": "{\n\"email_recipients\": \"@{pipeline().globalParameters.email_recipient}\",\n\"email_subject\": \"@{variables('email_subject')}\",\n\"email_body_header\": \"@{variables('email_body_header')}\",\n\"email_body_footer\": \"@{variables('email_body_footer')}\",\n\"email_body_status_table\":@{activity('Read Audit_log for a run_id').output.value}\n}\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare logic apps body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_app_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_app_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "5699edee-9b49-46c5-acb8-6d52ef1ff6ea"
			}
		},
		"variables": {
			"email_body_header": {
				"type": "String"
			},
			"email_body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_app_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}